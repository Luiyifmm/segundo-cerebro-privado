7268013602_n.jpg?stp=c0.248.640.640a_dst-jpg_e15_s640x639_tt6&_nc_cat=107&ig_cache_key=Mzk1MjM1NDYyMjkyNDE4Mzg0NA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=ZYfUiKWnBbEQ7kNvwFVwo-D&_nc_oc=Adr-Pkhefw8Ev94pGJfmm5yccP32lnBbFt05tDwAuTS-WfLiWqxKXWy_NwfFFek9MZ0&_nc_zt=23&_nc_ht=scontent-bog2-2.cdninstagram.com&_nc_gid=OHnew5Y4oNHjQo3JGwUf0g&_nc_ss=7ba8c&oh=00_AQPtoUrDyrMhTu7ZxPHEbke1nAO4nDseJ4m9kuICN5_WEA&oe=6ACD9A7F", "width": 640, "height": 640, "id": "9", "resolution": "640x640"}, {"url": "https://scontent-bog2-2.cdninstagram.com/v/t51.71878-15/760411003_1048264131477198_5852564567268013602_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=107&ig_cache_key=Mzk1MjM1NDYyMjkyNDE4Mzg0NA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=ZYfUiKWnBbEQ7kNvwFVwo-D&_nc_oc=Adr-Pkhefw8Ev94pGJfmm5yccP32lnBbFt05tDwAuTS-WfLiWqxKXWy_NwfFFek9MZ0&_nc_zt=23&_nc_ht=scontent-bog2-2.cdninstagram.com&_nc_gid=OHnew5Y4oNHjQo3JGwUf0g&_nc_ss=7ba8c&oh=00_AQMby-eguI_Y8VWWBCQ2goX1hZyD47sBwqvIHbykx4nmTg&oe=6ACD9A7F", "width": 640, "height": 1136, "id": "10", "resolution": "640x1136"}], "comments": [{"author": "johnrincon544", "author_id": "49256581505", "id": "18109424993193580", "text": "Perdóname DIOS todopoderoso,  padre celestial, este mundo es una porquería un asco, prefiero mil veces una  prostituta qué entregarle el corazón a una mujer , mi corazón es tuyo señor , así sea yo un maldito pecador.", "timestamp": 1791466025, "like_count": 0}, {"author": "el_gordo_feo_2010", "author_id": "32305793512", "id": "18115818629323034", "text": "👏👏👏", "timestamp": 1791436622, "like_count": 0}, {"author": "taison4803", "author_id": "70579373961", "id": "18132251374781285", "text": "Gracias señor por darme la fortaleza de salir de esas🙌", "timestamp": 1791341894, "like_count": 0}, {"author": "bryancastro6763", "author_id": "67557434703", "id": "18030261770887283", "text": "Que bueno que la que viene no está cansada", "timestamp": 1791282207, "like_count": 0}, {"author": "andres_566778", "author_id": "47677416405", "id": "18165084136487583", "text": "Los hombres fallamos pero la mujer mas una mujer es mas astuta que el hombre la mujer fui quien fallo primero que el hombre", "timestamp": 1791271024, "like_count": 0}, {"author": "andres_566778", "author_id": "47677416405", "id": "18021520775919761", "text": "Dios tiene su última palabra pero la mujer es la que mandan eva fue la que fallo por eso ya somos pescadores", "timestamp": 1791270883, "like_count": 0}, {"author": "alex_pereyra_j", "author_id": "3182467198", "id": "18124933253486406", "text": "Lo hice dos veces y siento vergüenza absoluta y escuchar esto me quebró, en el momento no lo piensas, el camino al la destrucción es dulce en apariencia y amargo en lo profundo. Sentir vergüenza propia pesa demasiado, no se lo aconsejo a nadie.", "timestamp": 1791257707, "like_count": 0}, {"author": "alberto_anderlini", "author_id": "8496840790", "id": "18183582208423748", "text": "🙏", "timestamp": 1791208975, "like_count": 0}, {"author": "oscararrieta482", "author_id": "72359681608", "id": "18117850696956884", "text": "😔", "timestamp": 1791167420, "like_count": 0}, {"author": "mercympesantez", "author_id": "48975361076", "id": "17938871361370372", "text": "Ya busqué y leí ese versículo...", "timestamp": 1791136476, "like_count": 0}, {"author": "dukypelic", "author_id": "76198920466", "id": "18391651627166180", "text": "👏👏👏", "timestamp": 1791066405, "like_count": 0}, {"author": "_roman_1759", "author_id": "45869165941", "id": "18127570720878823", "text": "🔥", "timestamp": 1791019122, "like_count": 0}, {"author": "pitito_rodriguez", "author_id": "3055404319", "id": "18135482992727403", "text": "Osea que tenemos permiso del cielo en caso de que…", "timestamp": 1790707940, "like_count": 0}, {"author": "elmer86268", "author_id": "74709519186", "id": "18336524428277272", "text": "Padre cosejame porque soy un hombre pecador❤️", "timestamp": 1790659771, "like_count": 0}], "webpage_url": "https://www.instagram.com/reel/DbZlZbNxNkk/?stkn=YTlnc2Q5MzcxMDNq", "webpage_url_basename": "DbZlZbNxNkk", "webpage_url_domain": "instagram.com", "extractor": "Instagram", "extractor_key": "Instagram", "thumbnail": "https://scontent-bog2-2.cdninstagram.com/v/t51.71878-15/760411003_1048264131477198_5852564567268013602_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=107&ig_cache_key=Mzk1MjM1NDYyMjkyNDE4Mzg0NA%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=ZYfUiKWnBbEQ7kNvwFVwo-D&_nc_oc=Adr-Pkhefw8Ev94pGJfmm5yccP32lnBbFt05tDwAuTS-WfLiWqxKXWy_NwfFFek9MZ0&_nc_zt=23&_nc_ht=scontent-bog2-2.cdninstagram.com&_nc_gid=OHnew5Y4oNHjQo3JGwUf0g&_nc_ss=7ba8c&oh=00_AQMby-eguI_Y8VWWBCQ2goX1hZyD47sBwqvIHbykx4nmTg&oe=6ACD9A7F", "display_id": "DbZlZbNxNkk", "fulltitle": "Video by david7eduardo", "upload_date": "20260730", "epoch": 1791484902, "url": "https://scontent-bog2-1.cdninstagram.com/o1/v/t2/f2/m86/AQNPPc6Nj9TCUWvcveuu7fXoqcc_bUismYY_9ohDBYvu1m7uESs77txp1uXwzdHXDn_R7xmIP-T3VUwn9GsmP5AAv6OfhaqaLijGsJ8.mp4?_nc_cat=104&_nc_sid=5e9851&_nc_ht=scontent-bog2-1.cdninstagram.com&_nc_ohc=zo39eD22490Q7kNvwEPuD-1&efg=eyJ2ZW5jb2RlX3RhZyI6Inhwdl9wcm9ncmVzc2l2ZS5JTlNUQUdSQU0uQ0xJUFMuQzMuNjA4LmRhc2hfYmFzZWxpbmVfMV92MSIsInhwdl9hc3NldF9pZCI6MjMxNzAxNTIwNTc3Mzc3OSwiYXNzZXRfYWdlX2RheXMiOjcwLCJ2aV91c2VjYXNlX2lkIjoxMDA5OSwiZHVyYXRpb25fcyI6NjAsInVybGdlbl9zb3VyY2UiOiJ3d3cifQ%3D%3D&ccb=17-1&vs=8283fea9875a7ed5&_nc__gYEmRhc2hfYmFzZWxpbmVfMV92MREAdf4HZeadAQA&_nc_gid=OHnew5Y4oNHjQo3JGwUf0g&_nc_ss=7ba8c&_nc_zt=28&oh=00_AQNlQp8N2pGxGTZQI5YsaH7F7yGU0rQANyY1VDMLSPaxeg&oe=6AC9CE35", "protocol": "https", "ext": "mp4", "video_ext": "mp4", "audio_ext": "none", "dynamic_range": "SDR", "format_id": "3", "format": "3 - unknown", "_type": "video", "_version": {"version": "2026.08.19", "release_git_head": "594bd50c2c78ac